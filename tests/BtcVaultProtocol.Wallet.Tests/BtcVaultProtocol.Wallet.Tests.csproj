<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Princípio II: xUnit + a infraestrutura de execução (Microsoft.NET.Test.Sdk,
    xunit.runner.visualstudio) são os únicos pacotes permitidos aqui. O template do dotnet
    adiciona coverlet.collector por padrão — removido por não estar na stack fixa.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BtcVaultProtocol.Wallet.Core\BtcVaultProtocol.Wallet.Core.csproj" />
    <ProjectReference Include="..\..\src\BtcVaultProtocol.Wallet.Console\BtcVaultProtocol.Wallet.Console.csproj" />
  </ItemGroup>

</Project>
